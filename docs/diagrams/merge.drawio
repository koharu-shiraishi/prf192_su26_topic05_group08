        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {&#39;flowchart&#39;: {&#39;curve&#39;: &#39;stepAfter&#39;}}}%%\ngraph TD\n    Start([Start: merge arr, left, mid, right, type]) --&gt; Alloc[Allocate Temp Arrays: L and R]\n    Alloc --&gt; CopyData[Copy elements from arr to L and R]\n    CopyData --&gt; InitPtrs[Initialize Pointers: i = 0, j = 0, k = left]\n    \n    %% Vòng lặp so sánh chính\n    InitPtrs --&gt; LoopCheck{i &lt; n1 AND j &lt; n2?}\n    \n    %% Kiểm tra Sort theo tiêu chí nào\n    LoopCheck -- Yes --&gt; TypeCheck{type == 1 ?}\n    \n    TypeCheck -- Yes --&gt; CondStock{L[i].stock &lt;= R[j].stock?}\n    TypeCheck -- No --&gt; CondPeriod{L[i].warrantyPeriod &lt;= R[j].warrantyPeriod?}\n    \n    %% Đổ phần tử nhỏ hơn từ L hoặc R vào mảng gốc\n    CondStock -- Yes --&gt; TakeL[arr[k] = L[i], i++] --&gt; AdvanceK[k++] --&gt; LoopCheck\n    CondStock -- No --&gt; TakeR[arr[k] = R[j], j++] --&gt; AdvanceK\n    \n    CondPeriod -- Yes --&gt; TakeL\n    CondPeriod -- No --&gt; TakeR\n    \n    %% Xử lý phần tử còn sót lại\n    LoopCheck -- No --&gt; CopyRemL{i &lt; n1?}\n    CopyRemL -- Yes --&gt; RemL[Copy remaining L to arr[k], i++, k++] --&gt; CopyRemL\n    CopyRemL -- No --&gt; CopyRemR{j &lt; n2?}\n    \n    CopyRemR -- Yes --&gt; RemR[Copy remaining R to arr[k], j++, k++] --&gt; CopyRemR\n    \n    %% Giải phóng RAM mảng tạm để tránh leak bộ nhớ\n    CopyRemR -- No --&gt; FreeMem[Free Memory: L and R]\n    FreeMem --&gt; End([End])&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="aqs20EZMERfcukje4PdH-1">
